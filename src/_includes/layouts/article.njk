---
layout: layouts/base.njk
---
<article class="article">
  <header class="article-header">
    <p class="article-meta">
      <time datetime="{{ page.date | isoDate }}">{{ page.date | readableDate }}</time>
      ・執筆: {{ site.author }}
    </p>
    <h1>{{ title }}</h1>
    <p class="article-lead">{{ description }}</p>
  </header>
  {{ content | toc | safe }}
  <div class="article-body">
    {{ content | safe }}
  </div>
  {% if audience == "manager" %}{% include "partials/cta-manager.njk" %}{% else %}{% include "partials/cta.njk" %}{% endif %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": {{ title | dump | safe }},
    "description": {{ description | dump | safe }},
    "datePublished": "{{ page.date | isoDate }}",
    "dateModified": "{{ (updated or page.date) | isoDate }}",
    "url": "{{ site.url }}{{ page.url | url }}",
    "mainEntityOfPage": "{{ site.url }}{{ page.url | url }}",
    "image": "{{ site.url }}/img/mascot/hero.png",
    "author": {
      "@type": "Person",
      "name": "ラボ長",
      "description": "現役の食品メーカー社員。製造DX・SCM改善を担当。"
    },
    "publisher": { "@type": "Organization", "name": {{ site.name | dump | safe }}, "url": "{{ site.url }}/" }
  }
  </script>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": {{ site.name | dump | safe }}, "item": "{{ site.url }}/" },
      { "@type": "ListItem", "position": 2, "name": {{ title | dump | safe }}, "item": "{{ site.url }}{{ page.url | url }}" }
    ]
  }
  </script>
</article>
<nav class="back-link">
  <a href="/">← 記事一覧へ戻る</a>
</nav>
